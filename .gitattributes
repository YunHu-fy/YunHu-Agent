# 默认让 Git 自动区分文本与二进制，文本在仓库内统一存为 LF
* text=auto

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本强制 LF
*.sh text eol=lf

# 二进制资产，不做换行符转换
*.apk binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jks binary
*.bin binary
*.ttf binary
*.otf binary
